          "lines": [
            {
              "speakerId": "okumura",
              "text": "なぜ、現場にはいなかったと言った。"
            },
            {
              "speakerId": "kuroda",
              "text": "騒ぎを避けたかった。それだけです。"
            },
            {
              "speakerId": "minato",
              "text": "三崎にも、騒ぐなと言ったのか？"
            },
            {
              "speakerId": "kuroda",
              "text": "会社が困れば、困るのは社員です。彼には分からなかった。"
            },
            {
              "speakerId": "minato",
              "text": "負傷した社員は、もう困っていた。"
            },
            {
              "speakerId": "narrator",
              "text": "黒田は紙の端をそろえる。何も書き足せない指が、同じ場所をなぞった。"
            }
          ],
          "requires": [
            "F72"
          ],
          "grants": [
            "F73"
          ],
          "required": true
        },
        {
          "id": "p4-kuroda-act",
          "personId": "kuroda",
          "label": "転落時の行為",
          "lines": [
            {
              "speakerId": "okumura",
              "text": "宮原さんは背中を両手で押す動作を見ている。その人物が戻った戸口で、高瀬がお前の顔を見た。そこを説明しろ。"
            },
            {
              "speakerId": "kuroda",
              "text": "帰れと言ったんです。聞かなかった。"
            },
            {
              "speakerId": "kuroda",
              "text": "戻ってきて、また話そうとして。俺は……。"
            },
            {
              "speakerId": "okumura",
              "text": "続けろ。"
            },
            {
              "speakerId": "kuroda",
              "text": "……押しました。"
            }
          ],
          "requires": [
            "F73"
          ],
