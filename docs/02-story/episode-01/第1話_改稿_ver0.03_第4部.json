      "intro": [
        {
          "speakerId": "narrator",
          "text": "奥村が迎え、黒田を面会室へ案内した。俺は席を立って待つ。"
        },
        {
          "speakerId": "kuroda",
          "text": "会社の方でも、説明したはずですが。"
        },
        {
          "speakerId": "okumura",
          "text": "確認したいことが増えた。座ってくれ。"
        }
      ],
      "people": [
        "okumura",
        "segawa",
