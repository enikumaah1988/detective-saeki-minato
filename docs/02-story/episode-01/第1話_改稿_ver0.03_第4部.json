          "lines": [
            {
              "speakerId": "akari",
              "text": "仕事がなくなるかもしれないって、ずっと思ってたの？"
            },
            {
              "speakerId": "naoto",
              "text": "ああ。"
            },
            {
              "speakerId": "akari",
              "text": "私の学校のことも？"
            },
            {
              "speakerId": "naoto",
              "text": "続けてほしかった。父さんたちも、そう思ってたはずだから。"
            },
            {
              "speakerId": "akari",
              "text": "私、普通に通ってた。お兄ちゃんがそんなこと考えてるって、知らないで。"
            },
            {
              "speakerId": "narrator",
              "text": "声が細くなった。直人は、カップの手前を見ていた。"
            },
            {
              "speakerId": "akari",
              "text": "お金の話をしても、大丈夫って言うから。私、それで。"
            },
            {
              "speakerId": "naoto",
              "text": "大丈夫って言ったのは俺だ。"
            },
            {
              "speakerId": "naoto",
              "text": "黙るって決めたのも。あかりが学校へ行ったからじゃない。"
            },
            {
              "speakerId": "akari",
              "text": "分かってる。でも、話してほしかった。"
            },
            {
              "speakerId": "akari",
              "text": "私が何を言うか、聞いてほしかった。"
            },
            {
              "speakerId": "naoto",
              "text": "……ごめん。"
            },
            {
              "speakerId": "akari",
              "text": "いなくなった時、私、何かしたのかなって。帰りたくなくなったのかなって。"
            },
            {
              "speakerId": "naoto",
              "text": "違う。そんなことは。"
            },
            {
              "speakerId": "akari",
              "text": "うん。でも、分からなかった。"
            },
            {
              "speakerId": "narrator",
              "text": "直人の手が開く。握り込んだ指が、少しずつほどけた。"
            },
            {
              "speakerId": "naoto",
              "text": "警察で話すことも、仕事のことも、まだある。前と同じには戻れない。"
            },
            {
              "speakerId": "akari",
              "text": "一緒に考えよう。"
            },
            {
              "speakerId": "naoto",
              "text": "……ああ。"
            },
            {
              "speakerId": "akari",
              "text": "今日は、帰ってくる？"
            },
            {
              "speakerId": "naoto",
              "text": "帰る。"
            },
            {
              "speakerId": "narrator",
              "text": "あかりは涙を拭き、もう一度うなずいた。"
