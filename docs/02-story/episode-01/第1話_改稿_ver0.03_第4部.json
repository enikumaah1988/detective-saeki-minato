          "personId": "kuroda",
          "label": "当日の接触",
          "lines": [
            {
              "speakerId": "okumura",
              "text": "三崎と、その日に話したのか？"
            },
            {
              "speakerId": "kuroda",
              "text": "2年も前のことです。記憶だけでは。"
            },
            {
              "speakerId": "okumura",
              "text": "日誌と受領原本を確認した。接触の記録がある。"
            },
            {
              "speakerId": "kuroda",
              "text": "日付など、あとからでも……。"
            },
            {
              "speakerId": "minato",
              "text": "日誌を書いたのは宮原さんだ。控えを残したのは三崎だ。高瀬の話だけで集まったものじゃない。"
            },
            {
              "speakerId": "kuroda",
              "text": "高瀬君は、自分も嘘をついたと認めているんでしょう。"
            },
            {
              "speakerId": "minato",
              "text": "認めている。だから別の記録と証言で確かめた。"
            },
            {
              "speakerId": "okumura",
              "text": "三崎と話したのか？"
            },
            {
              "speakerId": "kuroda",
              "text": "……話はしました。"
            }
          ],
          "requires": [
            "F71"
          ],
          "grants": [
            "F72"
          ],
          "required": true
        },
        {
          "id": "p4-kuroda-absence",
          "personId": "kuroda",
