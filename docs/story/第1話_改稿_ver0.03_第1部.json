    {
      "id": "P1-03",
      "part": 1,
      "locationId": "office",
      "roomId": "office",
      "sceneTime": "2026-10-08T11:00:00",
      "intro": [],
      "people": [
        "akari",
        "mio"
      ],
      "required": [
        "p1-missing",
        "p1-morning",
        "p1-contact",
        "p1-workplace",
        "p1-company-answer",
        "p1-searched",
        "p1-police"
      ],
      "ask": [
        {
          "id": "p1-missing",
          "personId": "akari",
          "label": "帰らなくなった日",
          "lines": [
            {
              "speakerId": "minato",
              "text": "いつから帰っていない？"
            },
            {
              "speakerId": "akari",
              "text": "月曜日です。五日の朝に出かけて、そのまま。今日で三日になります。"
            },
            {
              "speakerId": "mio",
              "text": "五日の朝からですね。"
            },
            {
              "speakerId": "akari",
              "text": "夜には戻ると思っていました。夕飯も残しておいたんです。"
            }
          ],
          "requires": [],
          "grants": [
            "F01"
          ],
          "required": true
        },
        {
          "id": "p1-morning",
          "personId": "akari",
          "label": "最後の朝",
          "lines": [
            {
              "speakerId": "minato",
              "text": "最後に会った時は、どんな様子だった？"
            },
            {
              "speakerId": "akari",
              "text": "普通でした。七時半ごろ、いつもの服で。"
            },
            {
              "speakerId": "akari",
              "text": "私が、帰りに牛乳を買ってくるって言ったら、頼む、って。"
            },
            {
              "speakerId": "minato",
              "text": "仕事へ行くと、兄が言ったのか？"
            },
            {
              "speakerId": "akari",
              "text": "……言っていません。いつもの時間だったので、私がそう思いました。"
            },
            {
              "speakerId": "mio",
              "text": "『いつもの時間に家を出た』と書いておきますね。"
            },
            {
              "speakerId": "akari",
              "text": "何か変なところがなかったか、何度も考えました。でも、思い出せなくて。"
            },
            {
              "speakerId": "minato",
              "text": "覚えているところまででいい。"
            }
          ],
          "requires": [],
          "grants": [
            "F02",
            "morning"
          ],
          "required": true
        },
        {
          "id": "p1-contact",
          "personId": "akari",
          "label": "連絡",
          "lines": [
            {
              "speakerId": "minato",
              "text": "兄に連絡は取れたか？"
            },
            {
              "speakerId": "akari",
              "text": "電話もメッセージも、返ってきません。月曜日の夜からです。"
            },
            {
              "speakerId": "akari",
              "text": "最初は『遅いの？』って。そのあと、『どこにいるの』ばかり送ってしまって。"
            },
            {
              "speakerId": "akari",
              "text": "最後は、何でもいいから返してって。"
            },
            {
              "speakerId": "narrator",
              "text": "鞄から出したスマホを、あかりは裏返して膝に置いた。"
            },
            {
              "speakerId": "mio",
              "text": "連絡を試したことは分かりました。送った言葉を、ここで責めなくて大丈夫ですよ。"
            }
          ],
          "requires": [],
          "grants": [
            "F03",
            "contact"
          ],
          "required": true
        },
        {
          "id": "p1-workplace",
          "personId": "akari",
          "label": "勤務先",
          "lines": [
            {
              "speakerId": "minato",
              "text": "勤務先を教えてくれ。"
            },
            {
              "speakerId": "akari",
              "text": "東成ビルサービスです。ビルの管理や修繕の仕事をしています。"
            },
            {
              "speakerId": "mio",
              "text": "会社の連絡先は分かりますか？"
            },
            {
              "speakerId": "akari",
              "text": "はい。火曜日に電話した番号があります。"
            }
          ],
          "requires": [],
          "grants": [
            "F04"
          ],
          "required": true
        },
        {
          "id": "p1-company-answer",
          "personId": "akari",
          "label": "会社へ聞いたこと",
          "lines": [
            {
              "speakerId": "minato",
              "text": "会社からは、何と言われた？"
            },
            {
              "speakerId": "akari",
              "text": "その日から来ていないと。月曜日のことです。"
            },
            {
              "speakerId": "akari",
              "text": "仕事に行ったはずですって言ったんですけど、担当の方がいなくて分からないと。"
            },
            {
              "speakerId": "mio",
              "text": "そのお電話では、勤務の記録までは確認できなかったんですね。"
            },
            {
              "speakerId": "akari",
              "text": "はい。私も、何を聞けばいいか分からなくなって。"
            },
            {
              "speakerId": "minato",
              "text": "会社には、こちらから確かめる。"
            }
          ],
          "requires": [
            "F04"
          ],
          "grants": [
            "F05",
            "workplace"
          ],
          "required": true
        },
        {
          "id": "p1-searched",
          "personId": "akari",
          "label": "ほかに捜したところ",
          "lines": [
            {
              "speakerId": "minato",
              "text": "ほかに、誰かへ聞いたか？"
            },
            {
              "speakerId": "akari",
              "text": "思いつく人には。でも、誰も知りませんでした。警察にも相談しました。"
            }
          ],
          "requires": [
            "F03"
          ],
          "grants": [
            "F06a"
          ],
          "required": true
        },
        {
          "id": "p1-police",
          "personId": "akari",
          "label": "警察への相談",
          "lines": [
            {
              "speakerId": "minato",
              "text": "警察へ相談して、その後どうなった？"
            },
            {
              "speakerId": "akari",
              "text": "事件に巻き込まれたかは分からないと。まだ、兄の居場所は分からなくて。"
            },
            {
              "speakerId": "akari",
              "text": "私、自分でも何かしないと。待っているだけじゃ……。"
            },
            {
              "speakerId": "minato",
              "text": "ここへ来たのも、そのためだな。"
            },
            {
              "speakerId": "akari",
              "text": "はい。"
            }
          ],
          "requires": [
            "F06a"
          ],
          "grants": [
            "F06",
            "police-consulted"
          ],
          "required": true
        },
        {
          "id": "p1-age",
          "personId": "akari",
          "label": "兄の年齢",
          "lines": [
            {
              "speakerId": "minato",
              "text": "兄は、いくつだ？"
            },
            {
              "speakerId": "akari",
              "text": "二十九です。私とは八つ違います。"
            }
          ],
          "requires": [],
          "grants": [
            "known-naoto-age"
          ],
          "required": false
        },
        {
          "id": "p1-daily",
          "personId": "akari",
          "label": "普段の連絡",
          "lines": [
            {
              "speakerId": "minato",
              "text": "普段も、連絡を忘れることはあるか？"
            },
            {
              "speakerId": "akari",
              "text": "遅くなる時は必ず。短いんですけど、『先に食べて』とか？"
            },
            {
              "speakerId": "akari",
              "text": "私が返すのを忘れると、朝、何も言わずにスマホを指して。"
            },
            {
              "speakerId": "narrator",
              "text": "少し笑いかけた顔が、すぐ元へ戻った。"
            },
            {
              "speakerId": "akari",
              "text": "あの時は、細かいなって思ってました。"
            }
          ],
          "requires": [
            "F03"
          ],
          "grants": [
            "naoto-daily"
          ],
          "required": false
        },
        {
          "id": "p1-family",
          "personId": "akari",
          "label": "一緒に暮らす家族",
          "lines": [
            {
              "speakerId": "minato",
              "text": "家では、兄と二人か？"
            },
            {
              "speakerId": "akari",
              "text": "はい。両親はもういません。"
            },
            {
              "speakerId": "akari",
              "text": "兄は、仕事のことを家であまり話さないので。会社での知り合いも、私はほとんど。"
            },
            {
              "speakerId": "minato",
              "text": "知らないことまで答えなくていい。"
            }
          ],
          "requires": [],
          "grants": [
            "akari-family"
          ],
          "required": false
        }
      ],
      "speak": [],
      "inspect": [],
      "think": [],
