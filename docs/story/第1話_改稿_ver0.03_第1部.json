    },
    {
      "id": "P1-05",
      "part": 1,
      "locationId": "office",
      "roomId": "office",
      "sceneTime": "2026-10-08T11:35:00",
      "intro": [],
      "people": [
        "akari",
        "mio"
      ],
      "required": [
        "p1-accept",
        "p1-photo",
        "p1-client-contact"
      ],
      "ask": [
        {
          "id": "p1-photo",
          "personId": "akari",
          "label": "兄の写真",
          "lines": [
            {
              "speakerId": "mio",
              "text": "お兄さんのお写真をお持ちですか？"
            },
            {
              "speakerId": "akari",
              "text": "はい。最近のものを、持ってきました。"
            },
            {
              "speakerId": "narrator",
              "text": "透明な袋から、あかりが写真を抜いた。角を曲げないよう、両手で置く。"
            },
            {
              "speakerId": "minato",
              "text": "今も、この髪型か？"
            },
            {
              "speakerId": "akari",
              "text": "はい。仕事の帰りは、だいたいこの顔です。少し疲れて見えますけど。"
            },
            {
              "speakerId": "minato",
              "text": "捜す時に使わせてもらう。大切に預かる。"
            }
          ],
          "requires": [
            "F08"
          ],
          "grants": [
            "IT01",
            "search-photo"
          ],
          "required": true
        },
        {
          "id": "p1-client-contact",
          "personId": "akari",
          "label": "連絡先",
          "lines": [
            {
              "speakerId": "mio",
              "text": "ご連絡先をお預かりしてもよろしいでしょうか？"
            },
            {
              "speakerId": "akari",
              "text": "はい。"
            },
            {
              "speakerId": "narrator",
              "text": "澪は番号を一桁ずつ読み返した。"
            },
            {
              "speakerId": "mio",
              "text": "分かったことがあれば、こちらからご連絡します。"
            },
            {
              "speakerId": "minato",
              "text": "兄から連絡があった時も、教えてくれ。"
            },
            {
              "speakerId": "akari",
              "text": "分かりました。電話、持っておきます。"
            }
          ],
          "requires": [
            "IT01"
          ],
          "grants": [
            "F09",
            "akari-contact"
          ],
          "required": true
        }
      ],
      "speak": [
        {
